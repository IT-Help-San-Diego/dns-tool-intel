			<string>CF5BE98E-CADD-4FB7-BCBB-77F1108C0FBB</string>
			<key>AddResultsToDEVONthinkFormat</key>
			<integer>7</integer>
			<key>AddResultsToDEVONthinkReadability</key>
			<false/>
			<key>ArchiveResults</key>
			<true/>
			<key>BringToFront</key>
			<true/>
			<key>IgnoreHostsPref</key>
			<string></string>
			<key>IgnoreLinksPref</key>
			<string></string>
