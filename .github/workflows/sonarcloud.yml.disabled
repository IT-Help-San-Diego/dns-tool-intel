# =====================================================================
# DORMANT — SonarCloud paid SaaS decoupled April 2026 (cost reasons).
#
# This file is preserved as institutional knowledge for revival when
# local SonarQube Community Edition is brought online. While dormant the
# workflow CANNOT run at all:
#   - The .disabled extension means GitHub Actions does not load it.
#   - The `on:` block is `workflow_dispatch` only, BUT the job-level
#     `if:` clause below still gates on push/pull_request events. This
#     intentional double-lock means even if someone restores the .yml
#     extension by accident, manual dispatches from the Actions UI will
#     skip the job and not bill SonarCloud.
#
# To reactivate (3 steps):
#   1. Rename `sonarcloud.yml.disabled` → `sonarcloud.yml`
#   2. Restore the original triggers in the `on:` block (push to main +
#      pull_request: opened/synchronize/reopened) — the workflow_dispatch
#      below is a placeholder, not a runnable trigger while the job `if:`
#      is event-restricted.
#   3. Verify SONAR_TOKEN in repo secrets, or replace with a SonarQube
#      CE token and add `sonar.host.url` override pointing at the local
#      CE instance (in sonar-project.properties or as an env var).
#
# Compensating in-repo controls in effect while dormant:
#   - go test ./go-server/... -short -timeout 120s        (release-gate Gate 8)
#   - go vet ./go-server/...                              (release-gate Gate 8b)
#   - methodology / boundary / drift guards               (R009/R010/R011)
#   - TestCorpusPDFIntegrity                              (corpus banner audit)
#   - dependency-audit.yml                                (already separate)
# =====================================================================
name: SonarCloud Full Product Analysis

on:
  # Placeholder trigger while dormant — manual dispatches will be no-ops
  # because the job-level `if:` (below) still requires push/PR events.
  # See header for the intentional double-lock rationale.
  workflow_dispatch:

jobs:
  sonarcloud:
    name: SonarCloud Scan
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    if: >-
      github.event_name == 'push' ||
      (github.event_name == 'pull_request' &&
       github.actor != 'dependabot[bot]' &&
       github.event.pull_request.head.repo.full_name == github.repository)

    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - uses: actions/setup-go@v6
        with:
          go-version: '1.25.9'

      - name: Run Go tests with coverage
        run: |
          go test ./go-server/... \
            -coverprofile=coverage.out -covermode=atomic -count=1 -short -timeout 300s -parallel=2
        env:
          CGO_ENABLED: '0'
          GOGC: '50'
          GOMEMLIMIT: '6000MiB'

      - name: Verify coverage completeness
        run: |
          echo "=== Coverage report summary ==="
          TOTAL_LINES=$(grep -c "^dnstool" coverage.out || echo 0)
          HANDLER_LINES=$(grep -c "go-server/internal/handlers/" coverage.out || echo 0)
          ANALYZER_LINES=$(grep -c "go-server/internal/analyzer/" coverage.out || echo 0)
          echo "Total coverage lines: $TOTAL_LINES"
          echo "Handler coverage lines: $HANDLER_LINES"
          echo "Analyzer coverage lines: $ANALYZER_LINES"

          if [ "$HANDLER_LINES" -lt 100 ]; then
            echo "::error::Handler coverage missing from coverage.out ($HANDLER_LINES lines found, expected 100+)"
            echo "Packages present:"
            grep "^dnstool" coverage.out | sed 's|:.*||' | sed 's|/[^/]*$||' | sort -u
            exit 1
          fi

          if [ "$ANALYZER_LINES" -lt 50 ]; then
            echo "::error::Analyzer coverage missing from coverage.out ($ANALYZER_LINES lines found, expected 50+)"
            echo "Packages present:"
            grep "^dnstool" coverage.out | sed 's|:.*||' | sed 's|/[^/]*$||' | sort -u
            exit 1
          fi

          echo "=== Per-package coverage ==="
          go tool cover -func=coverage.out | grep "^total:" || true

      - name: Normalize coverage paths for SonarCloud
        run: |
          echo "=== Before normalization ==="
          head -3 coverage.out
          sed -i 's|^dnstool/||' coverage.out
          echo "=== After normalization ==="
          head -3 coverage.out
          echo "Normalized $(wc -l < coverage.out) coverage lines"

      - name: SonarCloud Scan
        uses: sonarsource/sonarqube-scan-action@v7
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: https://sonarcloud.io
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
