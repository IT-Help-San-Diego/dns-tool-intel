modules = ["go-1.25", "nodejs-20", "python-3.11", "web", "bash", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash build.sh && ./dns-tool-server"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5011
externalPort = 3000

[[ports]]
localPort = 5099
externalPort = 3002

[nix]
channel = "stable-25_05"
packages = ["fontconfig", "freetype", "ghostscript", "glib", "glibcLocales", "harfbuzz", "lcms2", "libimagequant", "libjpeg", "libsodium", "libtiff", "libwebp", "libxcrypt", "openjpeg", "pango", "tcl", "tk", "xcodebuild", "zlib"]

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "./dns-tool-server"]
build = ["bash", "build.sh", "--deploy"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

