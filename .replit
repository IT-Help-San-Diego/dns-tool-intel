modules = ["go-1.25", "nodejs-20", "python-3.11", "web", "bash", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash build.sh && ./dns-tool-server"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5011
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["fontconfig", "freetype", "ghostscript", "glib", "glibcLocales", "harfbuzz", "lcms2", "libimagequant", "libjpeg", "libsodium", "libtiff", "libwebp", "libxcrypt", "openjpeg", "pango", "tcl", "tk", "xcodebuild", "zlib"]

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "./dns-tool-server"]
build = ["bash", "build.sh", "--deploy"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
SONAR_ORG = "it-help-san-diego"
SONAR_PROJECT = "IT-Help-San-Diego_dns-tool-intel"
SMTP_PROBE_MODE = "remote"
MAINTENANCE_NOTE = "Developing!"
ANALYTICS_EXCLUDE_IPS = "76.218.253.212"
YOUTUBE_VIDEO_IDS = "forgotten-domain=kavj5GTxx4s"
GOCACHE = "/tmp/go-build-cache"
GOMODCACHE = "/tmp/go-mod-cache"

[userenv.development]
BASE_URL = "https://f2c73519-b3f3-4c33-90b1-699f833acae8-00-2qa7mtebx8ii8.picard.replit.dev"

[agent]
integrations = ["github:1.0.0", "notion:1.0.0"]
